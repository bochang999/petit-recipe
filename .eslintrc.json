{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": ["sw.js", "dist/sw.js"],
      "env": {
        "serviceworker": true,
        "es2021": true
      }
    }
  ],
  "globals": {
    "localStorage": "readonly",
    "history": "readonly",
    "navigator": "readonly"
  }
}